@@ -2,4 +2,8 @@ from decimal import Decimal, ROUND_HALF_UP
 
 
 def round_money(amount) -> Decimal:
+    # Decimal(float) keeps the exact binary value (2.675 -> 2.67499...),
+    # so go through repr() to use the shortest decimal form the user wrote.
+    if isinstance(amount, float):
+        amount = repr(amount)
     return Decimal(amount).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
