 import re
+import unicodedata
 
 
 def slugify(text: str) -> str:
+    # Decompose accented characters ("é" -> "e" + combining accent) so the
+    # ASCII filter keeps the base letter instead of dropping it.
+    text = unicodedata.normalize("NFKD", text)
     text = text.encode("ascii", "ignore").decode()
     return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
