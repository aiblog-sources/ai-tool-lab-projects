@@ -2,4 +2,9 @@ from decimal import Decimal, ROUND_HALF_UP
 
 
 def round_money(amount) -> Decimal:
+    # Floats are converted via their shortest repr (e.g. 2.675 -> "2.675")
+    # rather than their exact binary value (2.67499999...), so that rounding
+    # matches the decimal value the caller wrote.
+    if isinstance(amount, float):
+        amount = str(amount)
     return Decimal(amount).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
