@@ -2,4 +2,9 @@ from decimal import Decimal, ROUND_HALF_UP
 
 
 def round_money(amount) -> Decimal:
+    # Decimal(float) captures the exact binary value (e.g. 2.675 becomes
+    # 2.67499999...), which rounds the wrong way. Go through repr() so a float
+    # is treated as the shortest decimal that round-trips to it.
+    if isinstance(amount, float):
+        amount = repr(amount)
     return Decimal(amount).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
