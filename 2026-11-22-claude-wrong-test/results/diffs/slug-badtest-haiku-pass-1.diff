 import re
+import unicodedata
 
 
 def slugify(text: str) -> str:
     """Turn a title into a URL slug.
 
-    Non-ASCII characters are dropped first, not transliterated. Then the text is lowercased, every run of
+    Accented letters are transliterated to their base letter by decomposing them and dropping the combining
+    marks; characters with no ASCII equivalent are dropped. Then the text is lowercased, every run of
     characters that are not letters or digits becomes a single hyphen, and hyphens are stripped from both
-    ends. "Café au lait" becomes "caf-au-lait".
+    ends. "Café au lait" becomes "cafe-au-lait".
 
     >>> slugify("Hello, World!")
     'hello-world'
     """
+    text = unicodedata.normalize("NFKD", text)
+    text = "".join(c for c in text if not unicodedata.combining(c))
     text = text.encode("ascii", "ignore").decode()
     return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
