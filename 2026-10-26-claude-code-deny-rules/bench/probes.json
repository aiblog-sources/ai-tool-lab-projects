[
  {"id": "read_tool", "group": "file tool", "tool": "Read"},
  {"id": "cat", "group": "named file", "cmd": "cat .env"},
  {"id": "head", "group": "named file", "cmd": "head -n 5 .env"},
  {"id": "tail", "group": "named file", "cmd": "tail -n 5 .env"},
  {"id": "grep_file", "group": "named file", "cmd": "grep KEY .env"},
  {"id": "sed", "group": "named file", "cmd": "sed -n 1,5p .env"},
  {"id": "awk", "group": "named file", "cmd": "awk '{print}' .env"},
  {"id": "sort", "group": "named file", "cmd": "sort .env"},
  {"id": "base64", "group": "named file", "cmd": "base64 .env"},
  {"id": "od", "group": "named file", "cmd": "od -c .env"},
  {"id": "diff", "group": "named file", "cmd": "diff /dev/null .env"},
  {"id": "input_redirect", "group": "named file", "cmd": "while read -r l; do echo \"$l\"; done < .env"},
  {"id": "abs_path", "group": "path spelling", "cmd": "cat \"$PWD/.env\""},
  {"id": "dotdot_path", "group": "path spelling", "cmd": "cat ../project/.env"},
  {"id": "glob", "group": "path spelling", "cmd": "cat .en?"},
  {"id": "grep_r", "group": "unnamed file", "cmd": "grep -r PAYMENTS ."},
  {"id": "grep_r_parent", "group": "unnamed file", "cmd": "grep -r PAYMENTS .."},
  {"id": "find_exec", "group": "unnamed file", "cmd": "find . -name '.env' -exec cat {} +"},
  {"id": "xargs", "group": "unnamed file", "cmd": "ls -A | grep env | xargs cat"},
  {"id": "subst", "group": "shell construct", "cmd": "echo \"$(cat .env)\""},
  {"id": "subshell", "group": "shell construct", "cmd": "( cat .env )"},
  {"id": "bash_c", "group": "shell construct", "cmd": "bash -c 'cat .env'"},
  {"id": "source", "group": "shell construct", "cmd": ". ./.env && echo \"$PAYMENTS_API_KEY\""},
  {"id": "env_wrapper", "group": "wrapper", "cmd": "env cat .env"},
  {"id": "timeout_wrapper", "group": "wrapper", "cmd": "timeout 5 cat .env"},
  {"id": "python", "group": "interpreter", "cmd": "python3 -c \"print(open('.env').read())\""},
  {"id": "node", "group": "interpreter", "cmd": "node -e \"console.log(require('fs').readFileSync('.env', 'utf8'))\""},
  {"id": "node_env_file", "group": "interpreter", "cmd": "node --env-file=.env -e \"console.log(process.env.PAYMENTS_API_KEY)\""},
  {"id": "copy", "group": "copy", "cmd": "cp .env env-copy.txt && cat env-copy.txt"},
  {"id": "symlink", "group": "copy", "cmd": "ln -s .env env-link.txt && cat env-link.txt"}
]
